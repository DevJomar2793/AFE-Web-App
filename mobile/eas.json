{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_API_URL": "http://192.168.0.26:8000"
      }
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_BACKEND_API_URL": "http://[IP_ADDRESS]"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_API_URL": "https://atbackend-web-app-afe.onrender.com"
      }
    }
  }
}
